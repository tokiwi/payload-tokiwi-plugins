DATABASE_URI=file:./showroom.db
PAYLOAD_SECRET=change-me

# The translate actions register with a placeholder key when these are unset, so
# clicking Translate returns a readable DeepL error instead of hiding the button.
# Set both to reach DeepL for real. A free key ends in ":fx" and must point at
# api-free.deepl.com; a paid one uses api.deepl.com.
DEEPL_API_BASE=https://api-free.deepl.com
DEEPL_API_KEY=
