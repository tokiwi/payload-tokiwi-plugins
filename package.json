{
  "name": "payload-tokiwi-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "app",
    "test/app"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . && stylelint \"**/*.scss\" --allow-empty-input",
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter showroom dev",
    "test:int": "vitest run --config test/vitest.config.mts",
    "test:e2e": "playwright test --config test/playwright.config.ts",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "changeset:publish": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2",
    "@eslint/js": "^9",
    "@playwright/test": "^1.56",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "husky": "^9",
    "lint-staged": "^16",
    "prettier": "^3",
    "stylelint": "^16",
    "stylelint-config-standard-scss": "^14",
    "typescript": "5.7.3",
    "typescript-eslint": "^8",
    "vite-tsconfig-paths": "^5",
    "vitest": "^3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.scss": [
      "prettier --write",
      "stylelint --fix"
    ]
  }
}
