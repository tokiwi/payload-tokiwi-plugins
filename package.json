{
  "name": "payload-tokiwi-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "app",
    "test/app"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc -p test/tsconfig.json",
    "lint": "eslint . && stylelint \"**/*.scss\" --allow-empty-input",
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter showroom dev",
    "test:int": "vitest run --config test/vitest.config.mts",
    "test:e2e": "playwright test --config test/playwright.config.ts",
    "test:types": "tstyche",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "changeset:publish": "changeset publish",
    "prepare": "husky"
  },
  "overrides": {
    "sass": "^1.93"
  },
  "devDependencies": {
    "@changesets/cli": "^3",
    "@eslint/js": "^10",
    "@playwright/test": "^1.64",
    "@tokiwi/payload-translate-deepl": "workspace:*",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "husky": "^9",
    "lint-staged": "^17",
    "payload": "3.90.2",
    "prettier": "^3",
    "stylelint": "^17",
    "stylelint-config-standard-scss": "^17",
    "tstyche": "^7",
    "typescript": "7.0.2",
    "typescript-eslint": "^8",
    "vitest": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.scss": [
      "prettier --write",
      "stylelint --fix"
    ]
  }
}
