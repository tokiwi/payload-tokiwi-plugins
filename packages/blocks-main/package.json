{
  "name": "@tokiwi/payload-blocks-main",
  "version": "0.0.0",
  "description": "Payload CMS block schemas shared by every Tokiwi project, with Mantine front-end templates",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "blocks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokiwi/payload-tokiwi-plugins.git",
    "directory": "packages/blocks-main"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "payload-blocks-main": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@mantine/carousel": "^9.6",
    "@mantine/core": "^9.6",
    "payload": "^3.90"
  },
  "peerDependenciesMeta": {
    "@mantine/carousel": {
      "optional": true
    },
    "@mantine/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mantine/carousel": "9.6.2",
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "embla-carousel": "8.6.0",
    "payload": "3.90.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
