{
  "name": "@tokiwi/payload-translate-deepl",
  "version": "0.1.1",
  "description": "Translate a Payload document into another locale with DeepL, from the admin panel.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokiwi/payload-tokiwi-plugins.git",
    "directory": "packages/translate-deepl"
  },
  "homepage": "https://github.com/tokiwi/payload-tokiwi-plugins/tree/main/packages/translate-deepl",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && sass src/styles.scss dist/styles.css --no-source-map --style=compressed",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@payloadcms/translations": "^3.90",
    "@payloadcms/ui": "^3.90",
    "next": ">=15.4.11",
    "payload": "^3.90",
    "react": "^19"
  },
  "devDependencies": {
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@types/react": "^19",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.1",
    "sass": "^1.93",
    "typescript": "5.7.3"
  }
}
